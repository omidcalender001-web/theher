---
// S00 — entry moment: one button starts the story (+ score).
// 8s after dismissal without user scroll, the film auto-advances (main.js).
import en from '../i18n/en.json';
const t = en;
---
<div class="entry" id="entry" role="dialog" aria-label="Start the story">
  <div class="entry__inner">
    <p class="entry__lockup" data-i18n="entry.kicker">{t.entry.kicker}</p>
    <p class="entry__line" data-i18n="entry.line">{t.entry.line}</p>
    <div class="entry__choices">
      <button class="entry__btn entry__btn--primary" data-entry-start data-i18n="entry.start">{t.entry.start}</button>
    </div>
  </div>
</div>
