---
// S00 — entry moment: one button starts the story (+ score).
// 8s after dismissal without user scroll, the film auto-advances (main.js).
import en from '../i18n/en.json';
const t = en;
---
<div class="entry" id="entry" role="dialog" aria-label="Start the story">
  <div class="entry__ambient" aria-hidden="true">
    <svg class="entry__aperture" viewBox="0 0 360 360" fill="none">
      <circle cx="180" cy="180" r="168" stroke="currentColor" stroke-opacity="0.14" stroke-width="0.75" />
      <circle class="entry__ring-outer" cx="180" cy="180" r="132" stroke="currentColor" stroke-opacity="0.22" stroke-width="0.75" stroke-dasharray="4 8" />
      <circle class="entry__ring-inner" cx="180" cy="180" r="88" stroke="currentColor" stroke-opacity="0.18" stroke-width="0.75" />
      <line x1="180" y1="0" x2="180" y2="44" stroke="currentColor" stroke-opacity="0.25" stroke-width="0.75" />
      <line x1="180" y1="316" x2="180" y2="360" stroke="currentColor" stroke-opacity="0.25" stroke-width="0.75" />
      <line x1="0" y1="180" x2="44" y2="180" stroke="currentColor" stroke-opacity="0.25" stroke-width="0.75" />
      <line x1="316" y1="180" x2="360" y2="180" stroke="currentColor" stroke-opacity="0.25" stroke-width="0.75" />
    </svg>
  </div>
  <div class="entry__inner">
    <span class="entry__meta bidi-ltr" aria-hidden="true">00 / 11 · INTERACTIVE FILM</span>
    <p class="entry__lockup" data-i18n="entry.kicker">{t.entry.kicker}</p>
    <p class="entry__line" data-i18n="entry.line">{t.entry.line}</p>
    <div class="entry__choices">
      <button
        class="entry__btn entry__btn--primary"
        data-entry-start
        data-magnetic
        data-cursor="play"
        data-i18n="entry.start">{t.entry.start}</button>
    </div>
  </div>
</div>
