---
// S10 — THE PARTNERSHIP — value + 3 collaboration models
import en from '../i18n/en.json';
const t = en;
---
<section class="section" id="s10" data-section aria-label="Partnership models">
  <div class="models__bg-wrap" aria-hidden="true">
    <video class="models__bg" data-lazy muted loop playsinline preload="metadata" poster="/images/posters/scene-06-collaboration-poster.jpg">
      <source src="/video/scene-06-collaboration.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="container">
    <div class="section-head" data-reveal-group>
      <p class="kicker" data-reveal data-i18n="s10.kicker">{t.s10.kicker}</p>
      <h2 class="display" data-reveal data-i18n="s10.headline">{t.s10.headline}</h2>
      <p data-reveal style="color:var(--color-text-muted)" data-i18n="s10.subheadline">{t.s10.subheadline}</p>
      <p data-reveal style="color:var(--color-text-muted);max-inline-size:38rem" data-i18n="s10.body">{t.s10.body}</p>
    </div>
    <div class="models" data-reveal-group>
      {t.s10.models.map((m, i) => (
        <div
          class={`card model ${i === 0 ? 'is-expanded' : ''}`}
          data-reveal
          data-model-card={i}
          data-tilt
          data-cursor="explore"
          tabindex="0"
          role="button"
          aria-expanded={i === 0 ? 'true' : 'false'}>
          <div class="model__head">
            <span class="mosaic__num" data-i18n={`nums.${i}`}>{String(i + 1).padStart(2, '0')}</span>
            <svg class="model__topology" viewBox="0 0 120 28" fill="none" aria-hidden="true">
              {i === 0 && (
                <>
                  <circle cx="20" cy="14" r="5" stroke="currentColor" stroke-width="1.2" />
                  <line x1="28" y1="14" x2="92" y2="14" stroke="currentColor" stroke-width="1" />
                  <circle cx="100" cy="14" r="5" fill="currentColor" />
                </>
              )}
              {i === 1 && (
                <>
                  <circle cx="18" cy="14" r="4.5" stroke="currentColor" stroke-width="1.2" />
                  <line x1="25" y1="14" x2="53" y2="14" stroke="currentColor" stroke-width="1" />
                  <circle cx="60" cy="14" r="4.5" fill="currentColor" />
                  <line x1="67" y1="14" x2="95" y2="14" stroke="currentColor" stroke-width="1" />
                  <circle cx="102" cy="14" r="4.5" stroke="currentColor" stroke-width="1.2" />
                </>
              )}
              {i === 2 && (
                <>
                  <circle cx="20" cy="14" r="4.5" stroke="currentColor" stroke-width="1.2" />
                  <line x1="27" y1="14" x2="66" y2="14" stroke="currentColor" stroke-width="1" />
                  <circle cx="73" cy="14" r="4.5" stroke="currentColor" stroke-width="1.2" />
                  <path d="M 20 20 Q 46 27 100 18" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3" />
                  <circle cx="102" cy="14" r="3.5" fill="currentColor" opacity="0.65" />
                </>
              )}
            </svg>
          </div>
          <span class="model__title" data-i18n={`s10.models.${i}.title`}>{m.title}</span>
          <span class="model__formula bidi-ltr" data-i18n={`s10.models.${i}.formula`}>{m.formula}</span>
          <span class="model__line" data-i18n={`s10.models.${i}.line`}>{m.line}</span>
        </div>
      ))}
    </div>
  </div>
</section>
