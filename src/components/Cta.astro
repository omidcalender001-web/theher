---
// S11 — CTA + LIVE PREVIEW of omidadli.site (Mode A iframe desktop / Mode B mobile)
// + future band (scene 07) before the final invitation + interactive Partnership Brief Drawer
import en from '../i18n/en.json';
const t = en;
const previewUrl = 'https://omidadli.site';
---
<section class="band" data-section data-dark-scene aria-label="The future">
  <video data-lazy muted loop playsinline preload="metadata" poster="/images/posters/scene-07-future-poster.jpg" aria-hidden="true">
    <source src="/video/scene-07-future.mp4" type="video/mp4" />
  </video>
  <div class="container">
    <p class="kicker" style="justify-content:center;color:var(--color-on-dark-muted)" data-i18n="s11.kicker">{t.s11.kicker}</p>
    <h2 class="display" style="color:var(--color-warm-white)" data-i18n="s11.headline">{t.s11.headline}</h2>
  </div>
</section>

<section class="section cta" id="s11" data-section aria-label="Call to action">
  <div class="container" style="display:grid;gap:2.4rem;justify-items:center;text-align:center">
    <div style="display:grid;gap:1.2rem;justify-items:center" data-reveal-group>
      <p data-reveal style="color:var(--color-text-muted);max-inline-size:36rem" data-i18n="s11.subheadline">{t.s11.subheadline}</p>
      <p data-reveal style="color:var(--color-text-muted);max-inline-size:38rem" data-i18n="s11.body">{t.s11.body}</p>
    </div>

    <div class="preview" data-reveal-solo>
      <p class="kicker" style="margin-block-end:1rem" data-i18n="s11.preview.kicker">{t.s11.preview.kicker}</p>
      <div class="browser">
        <div class="browser__bar">
          <span class="browser__dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="browser__url">{t.s11.preview.url}</span>
          <a
            class="browser__ext bidi-ltr"
            href={previewUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-cursor="visit"
            aria-label="Open omidadli.site">↗</a>
        </div>
        <div class="browser__body">
          <iframe
            src="/api/preview"
            title="Live preview — omidadli.site"
            loading="lazy"></iframe>
        </div>
      </div>
      <div class="preview__note">
        <span data-i18n="s11.preview.note">{t.s11.preview.note}</span>
        <a
          class="link-underline"
          href={previewUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-cursor="visit"
          data-i18n="s11.preview.openNewTab">{t.s11.preview.openNewTab}</a>
      </div>
    </div>

    <div class="cta__actions" data-reveal-solo>
      <button
        type="button"
        class="btn btn--primary"
        data-open-drawer
        data-magnetic
        data-cursor="open"
        data-i18n="s11.button">{t.s11.button}</button>
      <a
        class="btn btn--secondary"
        href={previewUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-magnetic
        data-cursor="visit"
        data-i18n="s11.drawer.visitSite">{t.s11.drawer.visitSite}</a>
    </div>

    <div class="cta__closing">
      <p class="display" data-i18n="s11.closing.lockup">{t.s11.closing.lockup}</p>
      <p class="keyline" style="color:var(--color-text-muted)" data-i18n="s11.closing.line">{t.s11.closing.line}</p>
    </div>
  </div>
</section>

<!-- Bilingual Partnership Dialogue Drawer -->
<div class="drawer" id="contact-drawer" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="drawer-title">
  <div class="drawer__backdrop" data-close-drawer></div>
  <div class="drawer__panel">
    <div class="drawer__top">
      <span class="kicker" data-i18n="s11.drawer.kicker">{t.s11.drawer.kicker}</span>
      <button type="button" class="drawer__close" data-close-drawer data-magnetic data-cursor="open" data-i18n="s11.drawer.close">{t.s11.drawer.close}</button>
    </div>
    <h3 class="display drawer__title" id="drawer-title" data-i18n="s11.drawer.title">{t.s11.drawer.title}</h3>
    <p class="drawer__sub" data-i18n="s11.drawer.subtitle">{t.s11.drawer.subtitle}</p>

    <form class="drawer__form" id="drawer-form" novalidate>
      <div class="drawer__field">
        <label class="drawer__label" data-i18n="s11.drawer.modelLabel">{t.s11.drawer.modelLabel}</label>
        <div class="drawer__pills" role="radiogroup">
          {t.s10.models.map((m, i) => (
            <button
              type="button"
              class={`drawer__pill ${i === 0 ? 'is-selected' : ''}`}
              data-drawer-model={i}
              data-i18n={`s10.models.${i}.title`}>{m.title}</button>
          ))}
        </div>
      </div>

      <div class="drawer__field">
        <label class="drawer__label" data-i18n="s11.drawer.focusLabel">{t.s11.drawer.focusLabel}</label>
        <div class="drawer__pills" role="radiogroup">
          {t.s6.layers.map((l, i) => (
            <button
              type="button"
              class={`drawer__pill ${i === 0 ? 'is-selected' : ''}`}
              data-drawer-layer={i}
              data-i18n={`s6.layers.${i}.title`}>{l.title}</button>
          ))}
        </div>
      </div>

      <div class="drawer__field">
        <label class="drawer__label" for="drawer-note" data-i18n="s11.drawer.noteLabel">{t.s11.drawer.noteLabel}</label>
        <textarea
          id="drawer-note"
          class="drawer__textarea"
          rows="3"
          placeholder={t.s11.drawer.notePlaceholder}
          data-i18n-placeholder="s11.drawer.notePlaceholder"></textarea>
      </div>

      <div class="drawer__actions">
        <button type="submit" class="btn btn--primary" data-magnetic data-i18n="s11.drawer.submit">{t.s11.drawer.submit}</button>
        <a
          class="btn btn--secondary"
          href={previewUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-magnetic
          data-i18n="s11.drawer.visitSite">{t.s11.drawer.visitSite}</a>
      </div>
    </form>

    <div class="drawer__result" id="drawer-result" hidden>
      <h4 class="drawer__result-title" data-i18n="s11.drawer.sentTitle">{t.s11.drawer.sentTitle}</h4>
      <p class="drawer__result-body" data-i18n="s11.drawer.sentBody">{t.s11.drawer.sentBody}</p>
      <pre class="drawer__summary" id="drawer-summary"></pre>
      <div class="drawer__actions">
        <a
          class="btn btn--primary"
          href={previewUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-i18n="s11.drawer.visitSite">{t.s11.drawer.visitSite}</a>
      </div>
    </div>
  </div>
</div>
