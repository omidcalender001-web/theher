---
// S07 — PROOF OF THINKING — "We need more sales." 7-step diagnostic (scroll + tap)
import en from '../i18n/en.json';
const t = en;
---
<section class="stepper" id="s07" data-section aria-label="Proof of thinking">
  <div class="stepper__track">
    <div class="stepper__sticky">
      <div class="stepper__head">
        <p class="kicker" data-i18n="s7.kicker">{t.s7.kicker}</p>
        <h2 class="display" style="font-size:var(--text-title);margin-block-start:1rem" data-i18n="s7.headline">{t.s7.headline}</h2>
        <p style="color:var(--color-text-muted);font-size:0.92rem;margin-block-start:.6rem" data-i18n="s7.subheadline">{t.s7.subheadline}</p>
        <p style="color:var(--color-text-muted);font-size:0.88rem;margin-block-start:.8rem;max-inline-size:28rem" data-i18n="s7.body">{t.s7.body}</p>
      </div>
      <div class="step-panels" aria-live="polite">
        <div class="stepper__signal" aria-hidden="true">
          <svg viewBox="0 0 420 56" fill="none" class="stepper__signal-svg">
            <line x1="24" y1="28" x2="396" y2="28" stroke="currentColor" stroke-opacity="0.22" stroke-width="1" />
            <line id="stepper-signal-fill" x1="24" y1="28" x2="24" y2="28" stroke="currentColor" stroke-width="1.5" />
            {t.s7.diagnostic.map((_, i) => (
              <g class="stepper__node" data-node={i} transform={`translate(${24 + i * 62}, 28)`}>
                <circle r="7" fill="var(--color-ivory)" stroke="currentColor" stroke-width="1" />
                <circle class="stepper__node-core" r="3" fill="currentColor" />
              </g>
            ))}
          </svg>
        </div>
        {t.s7.diagnostic.map((d, i) => (
          <div class="step-panel" role="tabpanel">
            <div class="step-panel__tag">
              <span data-i18n={`nums.${i}`}>{String(i + 1).padStart(2, '0')}</span>
              <span>/</span>
              <span data-i18n={`s7.diagnostic.${i}.title`}>{d.title}</span>
            </div>
            <h3 class="step-panel__q" data-i18n={`s7.diagnostic.${i}.question`}>{d.question}</h3>
            <p class="step-panel__a" style="color:var(--color-text-muted);max-inline-size:36rem" data-i18n={`s7.diagnostic.${i}.answer`}>{d.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
  <div class="stepper__punch container">
    <h3 class="display keyline" data-i18n="s7.keyLine">{t.s7.keyLine}</h3>
  </div>
</section>
