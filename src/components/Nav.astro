---
// Minimal nav: brand · sound toggle · language switch · CTA
import en from '../i18n/en.json';
const t = en;
---
<nav class="nav" id="nav" aria-label="Main">
  <a class="nav__brand" href="#s01" data-magnetic data-cursor="explore">THE HER × OMID</a>
  <div class="nav__actions">
    <button class="nav__btn nav__sound" id="sound-toggle" aria-pressed="false" aria-label="Sound" data-magnetic data-cursor="sound">
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M2 6v4h3l4 3V3L5 6H2z" fill="currentColor"/>
        <path class="bar" d="M11 5.5c1.2 1.4 1.2 3.6 0 5" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
        <path class="bar bar--outer" d="M13 3.5c2 2.4 2 6.6 0 9" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
      </svg>
      <span id="sound-label" data-i18n="sound.on">Sound on</span>
    </button>
    <button class="nav__btn nav__lang" id="lang-switch" data-magnetic data-cursor="lang" data-i18n="nav.languageSwitch">{t.nav.languageSwitch}</button>
    <button class="nav__btn nav__cta" type="button" data-open-drawer data-magnetic data-cursor="open" data-i18n="nav.cta">{t.nav.cta}</button>
  </div>
</nav>
