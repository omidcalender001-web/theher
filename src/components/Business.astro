---
// S02 — ACT II · THE BUSINESS — mosaic of different businesses (typographic + editorial imagery, storyboard scene 2)
import en from '../i18n/en.json';
import imgJournal from '../assets/images/mosaic_journal_brand_1791208137156.jpg';
import imgDigital from '../assets/images/mosaic_digital_system_1791208154167.jpg';

const t = en;
const mosaicMedia = [
  typeof imgJournal === 'string' ? imgJournal : imgJournal.src,
  '/images/posters/scene-02-business-poster.jpg',
  '/images/posters/scene-06-collaboration-poster.jpg',
  typeof imgDigital === 'string' ? imgDigital : imgDigital.src
];
---
<section class="section" id="s02" data-section aria-label="Behind every ambitious woman, a different business">
  <div class="container">
    <div class="section-head" data-reveal-group>
      <p class="kicker" data-reveal data-i18n="s2.kicker">{t.s2.kicker}</p>
      <h2 class="display" data-reveal data-i18n="s2.headline">{t.s2.headline}</h2>
      <p data-reveal data-i18n="s2.subheadline" class="hero__sub" style="color:var(--color-text-muted)">{t.s2.subheadline}</p>
      <p data-reveal data-i18n="s2.body" style="color:var(--color-text-muted);max-inline-size:38rem">{t.s2.body}</p>
    </div>
    <div class="mosaic" data-reveal-group>
      {t.s2.mosaic.map((c, i) => (
        <div class="mosaic__cell" data-reveal data-tilt data-cursor="explore">
          <div class="mosaic__visual" aria-hidden="true">
            <img src={mosaicMedia[i]} alt="" loading="lazy" referrerpolicy="no-referrer" />
          </div>
          <div class="mosaic__content">
            <span class="mosaic__num" data-i18n={`s2.mosaic.${i}.num`}>{c.num}</span>
            <span class="mosaic__title" data-i18n={`s2.mosaic.${i}.title`}>{c.title}</span>
            <span class="mosaic__line" data-i18n={`s2.mosaic.${i}.line`}>{c.line}</span>
          </div>
        </div>
      ))}
    </div>
    <div style="margin-block-start:2.5rem" data-reveal-solo>
      <div class="media-frame" data-tilt data-cursor="explore">
        <video data-lazy muted loop playsinline preload="metadata" poster="/images/posters/scene-02-business-poster.jpg" aria-hidden="true">
          <source src="/video/scene-02-business.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </div>
</section>
